# Copy to .env.local for development. Never commit .env.local.

# Required in production. The deployment denies every request when this is unset - see
# lib/auth/access.ts. Generate one with: openssl rand -hex 32
APP_ACCESS_SECRET=

# Required in Phase 1. Server-side only - never NEXT_PUBLIC_. None of these are committed
# anywhere; put real values in .env.local (gitignored).
DEEPGRAM_API_KEY=

# LLM_PROVIDER picks the interviewer's provider - "gemini" (default) or "anthropic". You only
# need the key for whichever one is active; the other is optional. See src/lib/llm/provider.ts.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
